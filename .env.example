# AutoCut / 剪映 AI 自动化工作台配置 (复制为 .env 使用)

# === 大模型配置 (阿里云 DashScope / Qwen VLM) ===
QWEN_API_KEY=your_dashscope_api_key_here
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.7-plus

# === 语音识别服务配置 (ASR) ===
# ASR_BACKEND=remote (默认) 音频上传第三方; =local 本地 faster-whisper (需 pip install faster-whisper)
ASR_ENDPOINT=https://asr.smartbid.site/inference
ASR_API_KEY=your_asr_api_key_here
# ASR_BACKEND=remote
# ASR_LOCAL_MODEL=small

# === 自动感知 (素材落盘后后台分析, 消耗 VLM token, 默认关) ===
# AUTO_PERCEIVE=1

# === 服务 ===
RENDER_SERVER_HOST=0.0.0.0
RENDER_SERVER_PORT=9002
# 内部自调用基址 (默认按 RENDER_SERVER_PORT 推导, 一般无需设置)
# API_BASE=http://127.0.0.1:9002
# CORS 允许来源 (逗号分隔, 仅 Vite dev 需要; 留空 = 关闭 CORS)
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# === 剪映 / 系统路径 (默认按当前用户推导, 特殊安装才需要覆盖) ===
# JY_APP_BASE=C:\Users\<you>\AppData\Local\JianyingPro\Apps
# JY_DRAFT_ROOT=C:\Users\<you>\AppData\Local\JianyingPro\User Data\Projects\com.lveditor.draft
# VIDEOS_DIR=C:\Users\<you>\Videos

# === 渲染 ===
# 单任务渲染超时 (秒)
RENDER_TIMEOUT=600
# 任务记录保留时长 (秒)
TASK_TTL=86400
# 隔离桌面列表 (逗号分隔, 每个桌面 = 1 路并行渲染)
DESKTOP_NAMES=JYRender_0
# 校准坐标预设窗口尺寸
PRESET_W=1280
PRESET_H=720
